# Copy this file to .env and fill in your key. Never commit .env.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model used for extraction and drafting. Model names change; list the ones your key can use
# with a GET to https://generativelanguage.googleapis.com/v1beta/models (see README).
GEMINI_MODEL=gemini-3.5-flash-lite
